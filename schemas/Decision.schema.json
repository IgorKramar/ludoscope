{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "problem": {
      "type": "string",
      "maxLength": 20000
    },
    "context": {
      "type": "string",
      "maxLength": 20000
    },
    "alternatives": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "chosen": {
      "type": "string",
      "maxLength": 20000
    },
    "rationale": {
      "type": "string",
      "maxLength": 20000
    },
    "consequences": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
      }
    },
    "revisit_when": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "const": "approved"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "problem",
    "context",
    "alternatives",
    "chosen",
    "rationale",
    "consequences",
    "mechanics",
    "revisit_when",
    "date",
    "status"
  ],
  "additionalProperties": false
}
