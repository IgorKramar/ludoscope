{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "initial": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "processes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "probability": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "limit": {
            "default": 1,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "id",
          "inputs",
          "outputs",
          "probability",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "invariants": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "resource"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "seed",
    "steps",
    "initial",
    "processes",
    "invariants"
  ],
  "additionalProperties": false
}
