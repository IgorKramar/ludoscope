{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
    },
    "name": {
      "type": "string",
      "maxLength": 20000
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "explore",
        "design",
        "review",
        "validate"
      ]
    },
    "disabled_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
      }
    },
    "disabled_schools": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "requirements": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "canon": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "language",
    "mode",
    "disabled_sources",
    "disabled_schools",
    "requirements",
    "canon"
  ],
  "additionalProperties": false
}
