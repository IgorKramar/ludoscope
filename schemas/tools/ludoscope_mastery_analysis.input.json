{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skills": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "introduced_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "practice": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "variation": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          }
        },
        "required": [
          "id",
          "requires",
          "introduced_at",
          "practice",
          "variation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "skills"
  ],
  "additionalProperties": false
}
