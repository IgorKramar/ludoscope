{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 20000
    },
    "system": {
      "type": "string",
      "maxLength": 20000
    },
    "tags": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "genre": {
      "type": "string",
      "maxLength": 20000
    },
    "stage": {
      "type": "string",
      "maxLength": 20000
    },
    "mode": {
      "type": "string",
      "enum": [
        "explore",
        "design",
        "review",
        "validate"
      ]
    },
    "system_types": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "query",
    "system"
  ],
  "additionalProperties": false
}
