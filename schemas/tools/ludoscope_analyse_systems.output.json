{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feedback_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodes": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "Enables",
                    "Requires",
                    "Produces",
                    "Consumes",
                    "Modifies",
                    "Restricts",
                    "ConflictsWith",
                    "Reinforces",
                    "Counters",
                    "DependsOn",
                    "Measures",
                    "Validates",
                    "Implements"
                  ]
                },
                "evidence": {
                  "default": "",
                  "type": "string",
                  "maxLength": 20000
                },
                "status": {
                  "default": "DESIGN_HYPOTHESIS",
                  "type": "string",
                  "enum": [
                    "VERIFIED_SOURCE",
                    "PROJECT_FACT",
                    "MODEL_RESULT",
                    "PLAYTEST_OBSERVATION",
                    "DESIGN_HYPOTHESIS",
                    "EXPERT_INFERENCE",
                    "UNVERIFIED"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "type",
                "evidence",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "claim_type": {
            "type": "string",
            "const": "EXPERT_INFERENCE"
          },
          "interpretation": {
            "type": "string"
          }
        },
        "required": [
          "nodes",
          "edges",
          "claim_type",
          "interpretation"
        ],
        "additionalProperties": false
      }
    },
    "interaction_chains": {
      "type": "array",
      "items": {
        "maxItems": 500,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "experience_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "Enables",
              "Requires",
              "Produces",
              "Consumes",
              "Modifies",
              "Restricts",
              "ConflictsWith",
              "Reinforces",
              "Counters",
              "DependsOn",
              "Measures",
              "Validates",
              "Implements"
            ]
          },
          "evidence": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "status": {
            "default": "DESIGN_HYPOTHESIS",
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "PROJECT_FACT",
              "MODEL_RESULT",
              "PLAYTEST_OBSERVATION",
              "DESIGN_HYPOTHESIS",
              "EXPERT_INFERENCE",
              "UNVERIFIED"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "type",
          "evidence",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "scenario_tasks": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "limitations": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "feedback_components",
    "interaction_chains",
    "experience_links",
    "scenario_tasks",
    "limitations"
  ],
  "additionalProperties": false
}
