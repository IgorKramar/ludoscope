{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "initial": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "events": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "requires": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "effects": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "id",
          "requires",
          "effects"
        ],
        "additionalProperties": false
      }
    },
    "canon": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "max_states": {
      "default": 1000,
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "initial",
    "events"
  ],
  "additionalProperties": false
}
