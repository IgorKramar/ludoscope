{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claim_type": {
      "type": "string",
      "const": "MODEL_RESULT"
    },
    "model": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "initial": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "processes": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "inputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "outputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "probability": {
                "default": 1,
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "limit": {
                "default": 1,
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "id",
              "inputs",
              "outputs",
              "probability",
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "invariants": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "resource"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "seed",
        "steps",
        "initial",
        "processes",
        "invariants"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "number"
    },
    "final": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "executions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "value": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "step",
          "resource",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "stopped_early": {
      "type": "boolean"
    },
    "trajectory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "resources": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "step",
          "resources"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "claim_type",
    "model",
    "seed",
    "final",
    "executions",
    "violations",
    "stopped_early",
    "trajectory",
    "limitations"
  ],
  "additionalProperties": false
}
