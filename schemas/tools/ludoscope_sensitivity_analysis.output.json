{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "multiplier": {
        "type": "number"
      },
      "final": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "number"
        }
      },
      "violations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "step": {
              "type": "number"
            },
            "resource": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            },
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "step",
            "resource",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "multiplier",
      "final",
      "violations"
    ],
    "additionalProperties": false
  }
}
