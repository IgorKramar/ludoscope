{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "mechanic": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        "name": {
          "type": "string",
          "maxLength": 20000
        },
        "player_goal": {
          "type": "string",
          "maxLength": 20000
        },
        "player_actions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "preconditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "rules": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "state_transitions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "resources": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "feedback": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "failure_conditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "success_conditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          }
        },
        "expected_experiences": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "design_risks": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "validation_plan": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "tags": {
          "default": [],
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "genre": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "stage": {
          "default": "prototype",
          "type": "string",
          "maxLength": 20000
        },
        "choices": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "consequences": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "cost": {
                "type": "number"
              },
              "benefit": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "consequences"
            ],
            "additionalProperties": false
          }
        },
        "intentional_tradeoffs": {
          "default": [],
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "player_goal",
        "player_actions",
        "preconditions",
        "rules",
        "state_transitions",
        "resources",
        "feedback",
        "failure_conditions",
        "success_conditions",
        "dependencies",
        "expected_experiences",
        "design_risks",
        "validation_plan",
        "tags",
        "genre",
        "stage",
        "choices",
        "intentional_tradeoffs"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 20000
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "PROJECT_FACT",
              "MODEL_RESULT",
              "PLAYTEST_OBSERVATION",
              "DESIGN_HYPOTHESIS",
              "EXPERT_INFERENCE",
              "UNVERIFIED"
            ]
          },
          "evidence": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "assumptions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "relevant_theories": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "limitations": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "alternatives": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "validation_method": {
            "type": "string",
            "maxLength": 20000
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "supported",
              "contradicted"
            ]
          }
        },
        "required": [
          "claim",
          "claim_type",
          "evidence",
          "assumptions",
          "relevant_theories",
          "limitations",
          "alternatives",
          "validation_method",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "Theory",
              "Principle",
              "Lens",
              "Heuristic",
              "ResearchMethod",
              "MetricDefinition",
              "ExperimentTemplate",
              "DesignPattern",
              "AntiPattern",
              "Counterexample",
              "TheoryConflict"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "school": {
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "applicable_genres": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "applicable_stages": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "conditions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "questions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "recommendations": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "limitations": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "conflicting_entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "related_entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "SOURCE_REQUIRED",
              "EXPERT_INFERENCE"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "evidence_locator": {
            "type": "string",
            "maxLength": 20000
          },
          "interpretation": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "title",
          "description",
          "source_ids",
          "school",
          "tags",
          "applicable_genres",
          "applicable_stages",
          "conditions",
          "questions",
          "recommendations",
          "limitations",
          "conflicting_entry_ids",
          "related_entry_ids",
          "verification_status",
          "confidence",
          "evidence_locator",
          "interpretation"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "conflicts_with": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          }
        },
        "required": [
          "entry",
          "conflicts_with"
        ],
        "additionalProperties": false
      }
    },
    "affected_systems": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "experience_chain": {
      "type": "object",
      "properties": {
        "actions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "rules": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "state_changes": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "feedback": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "experience_hypotheses": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "required": [
        "actions",
        "rules",
        "state_changes",
        "feedback",
        "experience_hypotheses"
      ],
      "additionalProperties": false
    },
    "decision_status": {
      "type": "string",
      "const": "draft"
    },
    "reasoning_tasks": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "experiment": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "hypothesis_type": {
          "type": "string",
          "const": "DESIGN_HYPOTHESIS"
        },
        "method": {
          "type": "string"
        },
        "metrics": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "limitations": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "required": [
        "question",
        "hypothesis_type",
        "method",
        "metrics",
        "limitations"
      ],
      "additionalProperties": false
    },
    "intentional_tradeoffs": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "limitations": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "schema_version",
    "mechanic",
    "findings",
    "knowledge",
    "conflicts",
    "affected_systems",
    "experience_chain",
    "decision_status",
    "reasoning_tasks",
    "experiment",
    "intentional_tradeoffs",
    "limitations"
  ],
  "additionalProperties": false
}
