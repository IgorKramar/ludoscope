{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "Theory",
              "Principle",
              "Lens",
              "Heuristic",
              "ResearchMethod",
              "MetricDefinition",
              "ExperimentTemplate",
              "DesignPattern",
              "AntiPattern",
              "Counterexample",
              "TheoryConflict"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "school": {
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "applicable_genres": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "applicable_stages": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "conditions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "questions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "recommendations": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "limitations": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "conflicting_entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "related_entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
            }
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "SOURCE_REQUIRED",
              "EXPERT_INFERENCE"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "evidence_locator": {
            "type": "string",
            "maxLength": 20000
          },
          "interpretation": {
            "type": "string",
            "maxLength": 20000
          },
          "evidence": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                },
                "pdf_pages": {
                  "minItems": 1,
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "claim_scope": {
                  "type": "string",
                  "enum": [
                    "author_position",
                    "derived_method",
                    "cross_source_inference"
                  ]
                }
              },
              "required": [
                "source_id",
                "pdf_pages",
                "section",
                "claim_scope"
              ],
              "additionalProperties": false
            }
          },
          "selection": {
            "type": "object",
            "properties": {
              "any_tags": {
                "default": [],
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "all_tags": {
                "default": [],
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "excluded_tags": {
                "default": [],
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required_system_types": {
                "default": [],
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "modes": {
                "default": [],
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "explore",
                    "design",
                    "review",
                    "validate"
                  ]
                }
              }
            },
            "required": [
              "any_tags",
              "all_tags",
              "excluded_tags",
              "required_system_types",
              "modes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "title",
          "description",
          "source_ids",
          "school",
          "tags",
          "applicable_genres",
          "applicable_stages",
          "conditions",
          "questions",
          "recommendations",
          "limitations",
          "conflicting_entry_ids",
          "related_entry_ids",
          "verification_status",
          "confidence",
          "evidence_locator",
          "interpretation"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 20000
          },
          "authors": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "edition": {
            "type": "string",
            "maxLength": 20000
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "identifier": {
            "type": "string",
            "maxLength": 20000
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "SOURCE_REQUIRED"
            ]
          },
          "accessed_at": {
            "type": "string",
            "maxLength": 20000
          },
          "license": {
            "type": "string",
            "maxLength": 20000
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "provenance": {
            "type": "object",
            "properties": {
              "access": {
                "type": "string",
                "enum": [
                  "public_web",
                  "user_supplied"
                ]
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pdf_pages": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "verified_pdf_pages": {
                "maxItems": 20000,
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "content_verified": {
                "type": "boolean"
              },
              "redistribution": {
                "type": "string",
                "const": "metadata_and_original_analysis_only"
              }
            },
            "required": [
              "access",
              "content_verified",
              "redistribution"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "authors",
          "url",
          "verification_status",
          "accessed_at",
          "license",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "missing_ids": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "entries",
    "sources",
    "missing_ids"
  ],
  "additionalProperties": false
}
