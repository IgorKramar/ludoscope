{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claim_type": {
      "type": "string",
      "const": "MODEL_RESULT"
    },
    "explored_states": {
      "type": "number"
    },
    "unreachable_events": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "canon_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "state": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "path",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "limitations": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  },
  "required": [
    "claim_type",
    "explored_states",
    "unreachable_events",
    "canon_violations",
    "truncated",
    "limitations"
  ],
  "additionalProperties": false
}
