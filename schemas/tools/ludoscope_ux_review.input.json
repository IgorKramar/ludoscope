{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifacts": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "goal": {
      "type": "string",
      "maxLength": 20000
    },
    "visible_state": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "feedback": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "error_recovery": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "accessibility": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    },
    "input_latency_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "artifacts",
    "goal",
    "visible_state",
    "feedback",
    "error_recovery",
    "accessibility"
  ],
  "additionalProperties": false
}
