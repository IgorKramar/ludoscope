{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mechanic": {
      "type": "object",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        "name": {
          "type": "string",
          "maxLength": 20000
        },
        "player_goal": {
          "type": "string",
          "maxLength": 20000
        },
        "player_actions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "preconditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "rules": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "state_transitions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "resources": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "feedback": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "failure_conditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "success_conditions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          }
        },
        "expected_experiences": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "design_risks": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "validation_plan": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "tags": {
          "default": [],
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "genre": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "stage": {
          "default": "prototype",
          "type": "string",
          "maxLength": 20000
        },
        "choices": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "consequences": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "cost": {
                "type": "number"
              },
              "benefit": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "consequences"
            ],
            "additionalProperties": false
          }
        },
        "intentional_tradeoffs": {
          "default": [],
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "player_goal",
        "player_actions",
        "preconditions",
        "rules",
        "state_transitions",
        "resources",
        "feedback",
        "failure_conditions",
        "success_conditions",
        "dependencies",
        "expected_experiences",
        "design_risks",
        "validation_plan",
        "tags",
        "genre",
        "stage",
        "choices",
        "intentional_tradeoffs"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "GameVision",
            "HighConcept",
            "DesignPillars",
            "CoreGameplayLoop",
            "SystemSpecification",
            "MechanicSpecification",
            "ProgressionDesign",
            "EconomyDesign",
            "NarrativeDesign",
            "UXSpecification",
            "TechnicalConstraints",
            "RiskRegister",
            "DecisionRecord",
            "ExperimentPlan",
            "PlaytestReport"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "sources": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
          }
        },
        "history": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "type",
        "language",
        "status",
        "sources",
        "links",
        "history",
        "body"
      ],
      "additionalProperties": false
    },
    "language": {
      "default": "ru",
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    }
  },
  "required": [
    "language"
  ],
  "additionalProperties": false
}
