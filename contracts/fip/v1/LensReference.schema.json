{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "questions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "source_ids": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
      }
    },
    "evidence": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "artifact",
              "model",
              "playtest",
              "inference"
            ]
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "PROJECT_FACT",
              "MODEL_RESULT",
              "PLAYTEST_OBSERVATION",
              "DESIGN_HYPOTHESIS",
              "EXPERT_INFERENCE",
              "UNVERIFIED"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "uri": {
            "type": "string",
            "maxLength": 2000
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "limitations": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "id",
          "kind",
          "claim_type",
          "locator",
          "description",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "questions",
    "source_ids",
    "evidence",
    "interpretation",
    "limitations"
  ],
  "additionalProperties": false
}
