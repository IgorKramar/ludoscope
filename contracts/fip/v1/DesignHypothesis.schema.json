{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "claim_type": {
      "type": "string",
      "const": "DESIGN_HYPOTHESIS"
    },
    "falsification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "id",
    "statement",
    "claim_type",
    "falsification",
    "metric"
  ],
  "additionalProperties": false
}
