{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string",
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "artifact_refs": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "uri": {
                "type": "string",
                "maxLength": 2000
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "project_id",
              "kind",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "source",
                  "artifact",
                  "model",
                  "playtest",
                  "inference"
                ]
              },
              "claim_type": {
                "type": "string",
                "enum": [
                  "VERIFIED_SOURCE",
                  "PROJECT_FACT",
                  "MODEL_RESULT",
                  "PLAYTEST_OBSERVATION",
                  "DESIGN_HYPOTHESIS",
                  "EXPERT_INFERENCE",
                  "UNVERIFIED"
                ]
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              "uri": {
                "type": "string",
                "maxLength": 2000
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "limitations": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            "required": [
              "id",
              "kind",
              "claim_type",
              "locator",
              "description",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "type": "string",
          "const": "submitted"
        },
        "context": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "genre": {
              "default": "",
              "type": "string",
              "maxLength": 200
            },
            "audience": {
              "default": "",
              "type": "string",
              "maxLength": 1000
            },
            "author_goals": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "creative_principles": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "constraints": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "tags": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "system_types": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "disabled_sources": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "disabled_schools": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "required": [
            "subject"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "api_version",
        "request_id",
        "project_id",
        "timestamp",
        "status",
        "context"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "nodes": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "PlayerGoal",
                  "PlayerAction",
                  "Mechanic",
                  "Rule",
                  "Resource",
                  "System",
                  "GameState",
                  "Feedback",
                  "Dynamic",
                  "ExperienceGoal",
                  "NarrativeEvent",
                  "ProgressionMilestone",
                  "Constraint",
                  "Metric",
                  "Experiment",
                  "Evidence",
                  "DesignDecision"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 20000
              },
              "files": {
                "default": [],
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Enables",
                  "Requires",
                  "Produces",
                  "Consumes",
                  "Modifies",
                  "Restricts",
                  "ConflictsWith",
                  "Reinforces",
                  "Counters",
                  "DependsOn",
                  "Measures",
                  "Validates",
                  "Implements"
                ]
              },
              "evidence": {
                "default": "",
                "type": "string",
                "maxLength": 20000
              },
              "status": {
                "default": "DESIGN_HYPOTHESIS",
                "type": "string",
                "enum": [
                  "VERIFIED_SOURCE",
                  "PROJECT_FACT",
                  "MODEL_RESULT",
                  "PLAYTEST_OBSERVATION",
                  "DESIGN_HYPOTHESIS",
                  "EXPERT_INFERENCE",
                  "UNVERIFIED"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request",
    "graph"
  ],
  "additionalProperties": false
}
