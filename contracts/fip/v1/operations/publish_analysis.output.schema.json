{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "artifact_refs": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "uri": {
            "type": "string",
            "maxLength": 2000
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "project_id",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "artifact",
              "model",
              "playtest",
              "inference"
            ]
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "VERIFIED_SOURCE",
              "PROJECT_FACT",
              "MODEL_RESULT",
              "PLAYTEST_OBSERVATION",
              "DESIGN_HYPOTHESIS",
              "EXPERT_INFERENCE",
              "UNVERIFIED"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "uri": {
            "type": "string",
            "maxLength": 2000
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "limitations": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "id",
          "kind",
          "claim_type",
          "locator",
          "description",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "error"
      ]
    },
    "profile": {
      "type": "string",
      "const": "ludoscope.fip-v1-draft.1"
    },
    "confidence": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "calibrated": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "level",
        "rationale",
        "calibrated"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "preview",
            "published",
            "denied",
            "unavailable"
          ]
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        }
      },
      "required": [
        "state",
        "analysis_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "timestamp",
    "artifact_refs",
    "evidence",
    "status",
    "profile",
    "confidence",
    "publication"
  ],
  "additionalProperties": false
}
