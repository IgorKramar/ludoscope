{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "knowledge",
        "analysis",
        "recommendation",
        "evaluation",
        "integration"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "input_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "output_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "execution": {
      "type": "string",
      "const": "bounded_sync"
    },
    "read_only": {
      "type": "boolean"
    }
  },
  "required": [
    "operation",
    "engine",
    "description",
    "input_schema",
    "output_schema",
    "execution",
    "read_only"
  ],
  "additionalProperties": false
}
